AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012
IMAGE_TAG=prod-001

CLUSTER_NAME=hireforge-cluster
SERVICE_PREFIX=hireforge

EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/ecsTaskExecutionRole
TASK_ROLE_ARN=arn:aws:iam::123456789012:role/hireforge-ecs-task-role

S3_BUCKET=hireforge-resumes
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/hireforge-jobs
FRONTEND_URL=https://app.example.com
VITE_API_URL=https://api.example.com/api
BACKEND_INTERNAL_URL=https://api.example.com
GROQ_MODEL=qwen/qwen3.8-27b

MONGODB_URI_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789012:secret:hireforge/mongodb-uri
JWT_SECRET_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789012:secret:hireforge/jwt-secret
GROQ_API_KEY_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789012:secret:hireforge/groq-api-key
INTERNAL_WORKER_TOKEN_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789012:secret:hireforge/internal-worker-token

SUBNET_A=subnet-REPLACE_ME
SUBNET_B=subnet-REPLACE_ME
SECURITY_GROUP=sg-REPLACE_ME
TARGET_GROUP_FRONTEND_ARN=arn:aws:elasticloadbalancing:ap-south-1:123456789012:targetgroup/hireforge-frontend/REPLACE_ME
TARGET_GROUP_BACKEND_ARN=arn:aws:elasticloadbalancing:ap-south-1:123456789012:targetgroup/hireforge-backend/REPLACE_ME
