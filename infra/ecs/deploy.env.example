AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012
IMAGE_TAG=prod-001

CLUSTER_NAME=hirepulse-cluster
SERVICE_PREFIX=hirepulse

EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/ecsTaskExecutionRole
TASK_ROLE_ARN=arn:aws:iam::123456789012:role/hirepulse-ecs-task-role

S3_BUCKET=hirepulse-resumes
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/hirepulse-jobs
FRONTEND_URL=https://app.example.com
VITE_API_URL=https://api.example.com/api
BACKEND_INTERNAL_URL=https://api.example.com
GROQ_MODEL=qwen/qwen3.8-27b

MONGODB_URI_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789012:secret:hirepulse/mongodb-uri
JWT_SECRET_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789012:secret:hirepulse/jwt-secret
GROQ_API_KEY_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789012:secret:hirepulse/groq-api-key
INTERNAL_WORKER_TOKEN_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789012:secret:hirepulse/internal-worker-token

SUBNET_A=subnet-REPLACE_ME
SUBNET_B=subnet-REPLACE_ME
SECURITY_GROUP=sg-REPLACE_ME
TARGET_GROUP_FRONTEND_ARN=arn:aws:elasticloadbalancing:ap-south-1:123456789012:targetgroup/hirepulse-frontend/REPLACE_ME
TARGET_GROUP_BACKEND_ARN=arn:aws:elasticloadbalancing:ap-south-1:123456789012:targetgroup/hirepulse-backend/REPLACE_ME
