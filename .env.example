# Copy values from this file into:
# - .env for shared local config
# Backend and agent also support folder-level .env override files.
# Frontend reads only VITE_* variables from this root env.
#
# Do not commit real secrets.

MONGODB_URI=mongodb://127.0.0.1:27017/resumeforge
MONGODB_DB=resumeforge
JWT_SECRET=replace-with-a-long-random-secret
INTERNAL_WORKER_TOKEN=replace-with-a-long-shared-worker-secret

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
S3_BUCKET=hireforge-resumes
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/hireforge-jobs
SQS_VISIBILITY_TIMEOUT=300
SQS_HEARTBEAT_INTERVAL=60
PROCESSING_STALE_SECONDS=600

GROQ_API_KEY=replace-me
GROQ_MODEL=qwen/qwen3.8-27b
BACKEND_INTERNAL_URL=http://localhost:3001

FRONTEND_URL=http://localhost
PORT=3001
VITE_API_URL=/api
